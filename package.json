{
  "name": "memtrails",
  "version": "0.4.0",
  "description": "Retrieval and exploration for any text — e-mail, chat, notes, documents, news, commits, conversations. Searchable at once, on your own machine, in any language; optional consolidation into typed knowledge with a language model.",
  "keywords": [
    "retrieval",
    "search",
    "memory",
    "rag",
    "agent-memory",
    "long-term-memory",
    "embeddings",
    "late-interaction",
    "colbert",
    "maxsim",
    "qdrant",
    "knowledge-graph",
    "llm",
    "mcp",
    "multilingual"
  ],
  "license": "MIT",
  "author": "Corneliu Maftuleac",
  "homepage": "https://github.com/cmaftuleac/memtrails#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cmaftuleac/memtrails.git"
  },
  "bugs": {
    "url": "https://github.com/cmaftuleac/memtrails/issues"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./importers": {
      "types": "./dist/importers/index.d.ts",
      "import": "./dist/importers/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "optionalDependencies": {
    "@huggingface/tokenizers": "0.2.0",
    "onnxruntime-node": "1.23.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.25.12",
    "tsx": "^4.20.6",
    "typescript": "^5.6.0",
    "vitest": "^3.2.7"
  },
  "publishConfig": {
    "access": "public"
  }
}
